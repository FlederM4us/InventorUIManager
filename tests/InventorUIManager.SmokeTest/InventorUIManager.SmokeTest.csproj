<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>none</DebugType>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="FlederM4us.InventorUI.Manager" Version="1.0.5-preview.0.1" />
    <PackageReference Condition="'$(CI)' == 'true'" Include="Autodesk.Inventor.Interop" Version="*" PrivateAssets="All" />
    <Reference Condition="'$(CI)' != 'true'" Include="Autodesk.Inventor.Interop">
      <HintPath>C:\Program Files\Autodesk\Inventor 2026\Bin\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyAddinFile" AfterTargets="Build">
    <ItemGroup>
      <AddinFile Include="$(MSBuildProjectDirectory)\*.addin" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinFile)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>